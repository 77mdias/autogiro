# Lista das variáveis do app, para cadastrar no Criptenv (docs/segredos.md). Não copie para um .env:
# o app só roda em container (pnpm docker:up) e recebe os valores do cofre na hora de subir.
# Comentários sempre na linha de cima: ao copiar um valor, nada além dele vai junto (um comentário colado
# no AUTH_URL já derrubou o login em produção).

# --- Supabase Postgres (um projeto por ambiente) ---
# Pooler de transação, porta 6543: usado pelo app
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Session pooler, porta 5432 (IPv4): usado nas migrações
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Auth.js ---
# Gere com: openssl rand -base64 33
AUTH_SECRET=
# Google Cloud → Credenciais → ID do cliente OAuth ("Aplicativo da Web").
# Redirecionamento autorizado: <APP_BASE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Necessário fora da Vercel (container, next start); na Vercel é automático
AUTH_TRUST_HOST=true
# URL pública exata: com https://, sem barra no fim. Dev: domínio do ngrok. Produção: https://autogiro.wdias.tech
AUTH_URL=https://seu-dominio.ngrok-free.dev
# Base dos links nos e-mails; mesmo valor do AUTH_URL
APP_BASE_URL=https://seu-dominio.ngrok-free.dev

# --- Resend (e-mails de confirmação e de redefinição de senha; resend.com › API Keys) ---
RESEND_API_KEY=
# Remetente num domínio verificado no Resend
EMAIL_FROM=AutoGiro <nao-responda@77mdevseven.tech>

# --- Cloudflare R2 (API S3); buckets e token próprios por ambiente (docs/deploy.md) ---
# Hexadecimal da URL da API S3 do bucket, sem https:// nem .r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Token "Leitura e gravação de objetos", restrito aos dois buckets do ambiente
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket público das fotos e o domínio dele (sem barra no fim). Dev: URL r2.dev
R2_PUBLIC_BUCKET=autogiro-fotos
R2_PUBLIC_URL=https://fotos-autogiro.77mdevseven.tech
# Bucket das CNHs: SEM acesso público
R2_PRIVATE_BUCKET=autogiro-cnh

# --- Asaas (Sandbox e produção têm contas e chaves separadas) ---
# Integrações › Chaves de API. Começa com $: no Criptenv vai o valor real (criptenv set 'ASAAS_API_KEY=$aact_...')
ASAAS_API_KEY=
# Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# "on" liga o Checkout de cartão em Minha loja; vazio = venda assistida (link de pagamento + pnpm docker:exec pnpm loja)
ASAAS_CHECKOUT=
# authToken do webhook: 32 a 255 caracteres, sem espaço; NÃO é a API key. Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=
# WhatsApp de vendas da AutoGiro, com DDD (botão "Falar com a AutoGiro" na venda assistida)
AUTOGIRO_WHATSAPP=

# --- Rotinas ---
# Bearer do cron que apaga CNHs antigas (Cloudflare Worker). Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Painel do administrador (/admin) ---
# E-mails do dono do SaaS, separados por vírgula. Vazio = ninguém entra
ADMIN_EMAILS=

# --- Conta de teste (só dev) ---
# Pública de propósito: só dados falsos e e-mail de teste do Resend. Loja "Garagem Teste AutoGiro" no banco de dev
E2E_EMAIL=delivered+autogiro-teste@resend.dev
E2E_SENHA=Teste-a393deec54a2
