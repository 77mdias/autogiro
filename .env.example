# Supabase Postgres — pooler de transação (runtime) e conexão direta (migrações)
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres # transaction pooler — app
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres # session pooler (IPv4) — migrações

# Auth.js + Google OAuth (Google Cloud → Credenciais → ID do cliente OAuth, tipo "Aplicativo da Web").
# URI de redirecionamento autorizado: <APP_BASE_URL>/api/auth/callback/google
AUTH_SECRET= # npx auth secret  (ou openssl rand -base64 33)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true # necessário fora da Vercel (Cloudflare, next start)
APP_BASE_URL=http://localhost:3000

# Cloudflare R2 (API S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=autogiro-fotos
R2_PUBLIC_URL=https://fotos.seudominio.com.br # domínio público do bucket de fotos
R2_PRIVATE_BUCKET=autogiro-cnh # SEM acesso público

# Asaas — chave de API (Integrações › Chaves de API). Sandbox e produção têm contas e chaves separadas.
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3 # produção: https://api.asaas.com/v3
# "on" liga o Checkout de cartão em Minha loja; vazio = fase de venda assistida (link de pagamento + npm run loja)
ASAAS_CHECKOUT=
# WhatsApp de vendas da AutoGiro, com DDD (botão "Falar com a AutoGiro" na fase assistida)
AUTOGIRO_WHATSAPP=
# Asaas — authToken do webhook (32 a 255 caracteres, sem espaços; NÃO use a API key). openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Token do Cloudflare Workers Cron Trigger (openssl rand -hex 32)
CRON_SECRET=
